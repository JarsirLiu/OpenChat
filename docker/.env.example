COMPOSE_PROJECT_NAME=openchat

# Registry images used by production pulls and local build/push workflows.
OPENCHAT_APP_IMAGE=ccr.ccs.tencentyun.com/openchat/openchat-app:latest
OPENCHAT_NGINX_IMAGE=ccr.ccs.tencentyun.com/openchat/openchat-nginx:latest

# Published ports on the Docker host.
HTTP_PORT=80
HTTPS_PORT=443
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432

# Build mirrors.
APT_MIRROR=http://deb.debian.org/debian
APT_SECURITY_MIRROR=http://deb.debian.org/debian-security
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine

# Nginx reverse proxy.
OPENCHAT_SERVER_NAME=_
OPENCHAT_APP_UPSTREAM=app:8787
OPENCHAT_MINIO_UPSTREAM=minio:9000
OPENCHAT_CLIENT_MAX_BODY_SIZE=120m
SSL_CERT_NAME=localhost
NGINX_CERT_RELOAD_INTERVAL_SECONDS=21600
NGINX_CERT_RELOAD_CHECK_SECONDS=30
NGINX_CERT_RELOAD_FLAG_FILE=/etc/nginx/ssl/.reload-nginx

# Let's Encrypt / ACME.
ENABLE_LETSENCRYPT=false
LETSENCRYPT_DOMAIN=
LETSENCRYPT_ALT_DOMAINS=
LETSENCRYPT_EMAIL=
LETSENCRYPT_CA=letsencrypt
LETSENCRYPT_ECC_CURVE=ec-256
LETSENCRYPT_WEBROOT=/var/www/acme
LETSENCRYPT_CERT_PATH=/acme-certs
LETSENCRYPT_INIT_RETRY_SECONDS=30
LETSENCRYPT_RENEW_INTERVAL_SECONDS=43200
ACME_HOME=/acme-data

# OpenChat app runtime.
OPENCHAT_DATABASE_URL=postgresql://openchat:openchat123456@postgres:5432/openchat
OPENCHAT_PUBLIC_BASE_URL=http://localhost
OPENCHAT_AUTH_SECRET_KEY=change-me-in-production
OPENCHAT_PROVIDER_SECRET_KEY=change-me-in-production
OPENCHAT_AUTH_COOKIE_SECURE=false
OPENCHAT_AUTH_COOKIE_DOMAIN=
OPENCHAT_OPENAI_BASE_URL=https://aiapi.up.railway.app/v1
OPENCHAT_MEDIA_STORAGE_BACKEND=s3
OPENCHAT_S3_ENDPOINT=http://minio:9000
OPENCHAT_S3_REGION=us-east-1
OPENCHAT_S3_PUBLIC_BASE_URL=http://localhost/openchat-media
OPENCHAT_S3_FORCE_PATH_STYLE=true
RUST_LOG=openchat_server=info,openchat_core=info,tower_http=info

# Postgres.
POSTGRES_DB=openchat
POSTGRES_USER=openchat
POSTGRES_PASSWORD=openchat123456

# S3-compatible storage used by the app and MinIO.
OPENCHAT_S3_ACCESS_KEY_ID=minioadmin
OPENCHAT_S3_SECRET_ACCESS_KEY=minioadmin
OPENCHAT_S3_BUCKET=openchat-media
