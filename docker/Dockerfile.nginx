ARG NODE_BUILDER_IMAGE=node:20-bookworm-slim
ARG NGINX_RUNTIME_IMAGE=nginx:1.27-alpine
ARG ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine

FROM ${NODE_BUILDER_IMAGE} AS web-builder

WORKDIR /app

RUN corepack enable

# Copy workspace manifests first so pnpm install can be cached cleanly.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/chat-core/package.json packages/chat-core/package.json
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN pnpm install --frozen-lockfile

# Copy only the frontend sources needed for the web build.
COPY apps/web ./apps/web
COPY config/error-codes.json ./config/error-codes.json
COPY packages/chat-core ./packages/chat-core
COPY packages/protocol ./packages/protocol
COPY packages/ui ./packages/ui

RUN pnpm --filter @openchat/web build

FROM ${NGINX_RUNTIME_IMAGE}

ARG ALPINE_MIRROR

RUN sed -i "s|https://dl-cdn.alpinelinux.org/alpine|${ALPINE_MIRROR}|g" /etc/apk/repositories \
    && apk add --no-cache curl openssl gettext

COPY docker/scripts/nginx-entrypoint.sh /scripts/nginx-entrypoint.sh
RUN chmod +x /scripts/nginx-entrypoint.sh

COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/conf.d/default.conf.template /etc/nginx/templates/default.conf.template
COPY docker/nginx/snippets /etc/nginx/snippets
COPY --from=web-builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80
EXPOSE 443

CMD ["/bin/sh", "/scripts/nginx-entrypoint.sh"]
