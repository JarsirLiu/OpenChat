FROM node:20-bookworm-slim AS web-builder

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @openchat/web build

FROM nginx:1.27-alpine

RUN apk add --no-cache curl openssl gettext

COPY docker/scripts/nginx-entrypoint.sh /scripts/nginx-entrypoint.sh
RUN chmod +x /scripts/nginx-entrypoint.sh

COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/conf.d/default.conf.template /etc/nginx/templates/default.conf.template
COPY docker/nginx/snippets /etc/nginx/snippets
COPY --from=web-builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80
EXPOSE 443

CMD ["/bin/sh", "/scripts/nginx-entrypoint.sh"]
